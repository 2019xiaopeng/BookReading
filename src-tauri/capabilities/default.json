{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$APPDATA/library/**" }]
    },
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA/library/**" }]
    },
    "opener:default"
  ]
}
