{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bookreading",
  "version": "3.1.9",
  "identifier": "com.root.bookreading",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:14200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "bookreading",
        "width": 800,
        "height": 600,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "backgroundColor": "#FAFAF7"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3MDkxRTkwNzhFNzg0NjcKUldSbmhPZDRrQjRKVi9ncmFPYmNVVDE0T0xZTXNiQXJvejkwc3RIREVVcXhIWjVzWmZXdlJVc1kK",
      "endpoints": [
        "https://github.com/2019xiaopeng/BookReading/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
